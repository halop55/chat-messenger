{
  "expo": {
    "name": "chat-messenger",
    "slug": "chat-messenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chatmessenger",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.fpt.chatmessenger",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Cho phep ung dung truy cap micro de hai thiet bi co the goi va noi chuyen voi nhau."
      }
    },
    "android": {
      "package": "com.fpt.chatmessenger",
      "newArchEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phep ung dung truy cap thu vien anh de ban chon avatar va gui anh trong cuoc tro chuyen.",
          "cameraPermission": "Cho phep ung dung truy cap camera de ban chup avatar.",
          "microphonePermission": "Cho phep ung dung truy cap micro de goi thoai va thu am neu can."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
